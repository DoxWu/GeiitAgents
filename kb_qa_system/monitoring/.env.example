# Copy to monitoring/.env, replace every placeholder, and keep the copy untracked.
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# These must match the private backend runtime configuration.
PROMETHEUS_AUTH_USER=prometheus
PROMETHEUS_AUTH_PASSWORD=replace-with-the-same-long-random-password

# Configure a verified mailbox and sender before enabling alert email delivery.
ALERT_EMAIL_TO=admin@your-domain.example
ALERT_EMAIL_FROM="GeiIt Alerts <alerts@your-domain.example>"
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=replace-with-the-provider-smtp-credential
