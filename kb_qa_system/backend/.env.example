# ============================================
# GeiIt企业知识库 - 环境变量配置示例（生产版）
# ============================================
# 使用方法：复制本文件为 .env，并填入实际值
# cp .env.example .env
#
# ============================================
# Railway 部署必填变量速查
# ============================================
# 以下标注了每个变量在 Railway 中的配置方式：
#   [Railway自动注入] = Railway 服务引用会自动生成，无需手动填写
#   [必填]           = 必须手动在 Railway Variables 中填写
#   [推荐]           = 建议填写，不填会使用默认值
#   [可选]           = 按需填写，默认关闭
# ============================================

# ============================================
# 应用配置
# ============================================
# [必填] 运行环境：Railway 部署设为 production
ENVIRONMENT=production
# [推荐] 生产环境关闭调试模式（production 环境启动时会自动强制关闭）
DEBUG=False
# [Railway自动注入] 应用端口
PORT=8000

# ============================================
# CORS 跨域配置
# ============================================
# [必填] 允许的前端域名列表
# 作用：允许前端域名跨域访问后端 API，浏览器安全策略要求后端明确允许
# 配置格式：JSON 数组字符串，多个域名用逗号分隔
#
# 安全要求（生产环境启动时会校验）：
#   - 禁止使用通配符 *（会允许任意域名跨域访问，存在安全风险）
#   - 必须列出精确的前端域名
#   - 协议、域名、端口必须完全匹配（https:// 与 http:// 不同）
#
# Railway 部署示例：
#   CORS_ORIGINS=["https://your-frontend.up.railway.app","https://your-custom-domain.com"]
#
# 多环境部署（同时允许预发布和生产）：
#   CORS_ORIGINS=["https://app.example.com","https://staging-app.up.railway.app"]
# [Railway自动注入] Railway 提供 PostgreSQL 服务后会自动生成 DATABASE_URL
# 注意：Railway 自动注入的 URL 格式为 postgresql://，需改为 postgresql+psycopg://
#       例如：postgresql://user:pass@host:5432/db → postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kb_qa

# [推荐] 数据库连接池
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ============================================
# Redis 配置
# ============================================
# [Railway自动注入] Railway 提供 Redis 服务后会自动生成 REDIS_URL
REDIS_URL=redis://localhost:6379/0

# ============================================
# Celery 配置
# ============================================
# [推荐] 如果 Redis 服务 URL 不同于上方 REDIS_URL，需单独配置
# 默认从 REDIS_URL 推导 broker 和 result backend
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIMEOUT=600
CELERY_TASK_MAX_RETRIES=3

# ============================================
# 数据库迁移配置
# ============================================
# 所有平台默认启动检查并迁移；数据库锁防止多副本并发迁移。
MIGRATE_ON_STARTUP=true
DB_RECOVERY_ENABLED=true
DB_STARTUP_TIMEOUT_SECONDS=300
DB_RETRY_INTERVAL_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_OPERATION_TIMEOUT_SECONDS=600

# 仅当 users 为空时创建初始管理员；不会重置或提升已有账号。
# 完成首次初始化后可以关闭并移除 SUPERUSER_PASSWORD。
BOOTSTRAP_ADMIN_ENABLED=false
SUPERUSER_USERNAME=
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# 可选异地备份：外部 PostgreSQL 存储加密、多版本 pg_dump 档案。
# ROLE=ops 定时执行；必须部署在 Sealos 之外才能在 Sealos 整体故障时告警。
BACKUP_ENABLED=false
BACKUP_DATABASE_URL=
# 验证库管理连接：有 CREATEDB 权限、服务器安装 pgvector；只创建/删除随机临时库。
BACKUP_VERIFY_ADMIN_URL=
# 执行 python -m app.ops.cli generate-key 生成，单独保管，丢失后无法解密备份。
BACKUP_ENCRYPTION_KEY=
BACKUP_SOURCE_ID=geiit-production
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=7
BACKUP_MAX_BYTES=2147483648
BACKUP_ALLOW_EMPTY=false
# 可选管理员管理接口 + 持久任务队列（API 与 ROLE=ops 读取相同备份配置）。
# 队列位于备份库，关闭网页不影响执行；默认关闭。
OPS_API_ENABLED=false
# HTTP 恢复只允许此预先配置的独立空目标库，不接受客户端提交任意连接串。
RESTORE_TARGET_DATABASE_URL=
RESTORE_TARGET_NAME=recovery
# 只有完全空的目标数据库才能自动恢复；无有效备份则拒绝继续初始化。
RESTORE_ON_EMPTY=false
RESTORE_MAX_AGE_HOURS=168

# 独立运维监控，直接发送故障/恢复邮件，不依赖主库、Redis、Celery。
# 使用后端 /ready 的公网 HTTPS 地址；不要填写仅返回静态 HTML 的前端首页。
OPS_MONITOR_URL=
OPS_INTERVAL_SECONDS=60
OPS_FAILURE_THRESHOLD=3
OPS_ALERT_COOLDOWN_SECONDS=3600
OPS_STATE_FILE=./data/ops-state.json
OPS_ALERTS_ENABLED=false
# 使用下面邮件配置中的 ADMIN_NOTIFY_EMAIL、EMAIL_FROM、EMAIL_PROVIDER、
# RESEND_API_KEY 或 SMTP_*；OPS_ALERTS_ENABLED 独立于业务 EMAIL_ENABLED。

# ============================================
# JWT 认证配置
# ============================================
# [必填] SECRET_KEY 必须设置为随机长字符串（≥32 字符），用于 JWT 签名
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 安全要求：
#   - 开发环境：留空则自动生成临时密钥（重启后失效，需重新登录）
#   - 生产环境：必须显式设置，否则应用拒绝启动
#   - 禁止使用弱密钥（secret、changeme、123456 等）
SECRET_KEY=
ALGORITHM=HS256
# [推荐] 生产环境建议短期 Access Token（15 分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# 邮件配置（Resend HTTP API 主通道 + SMTP 备用通道）
# ============================================
# [必填] 生产环境必须开启邮件（用于注册申请、密码重置）
EMAIL_ENABLED=False
# Separate feature flag for user scheduled reminders. Both flags must be true.
REMINDERS_ENABLED=False

# [必填] 邮件发送通道：http（推荐）/ smtp
# - http：Resend HTTP API（HTTPS 443，不受 Railway SMTP 限制，生产推荐）
# - smtp：SMTP 发送（本地开发或无 SMTP 限制的环境）
EMAIL_PROVIDER=http

# [必填-HTTP通道] Resend API Key（EMAIL_PROVIDER=http 时必填）
# 获取：https://resend.com/api-keys
# 格式：re_xxxxxxxxxxxx
# 注意：可与 SMTP_PASSWORD 使用同一个 Key
RESEND_API_KEY=

# [可选-SMTP通道] Resend SMTP 配置（EMAIL_PROVIDER=smtp 时使用）
# 获取 API Key：https://resend.com/api-keys
# 格式：re_xxxxxxxxxxxx
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key
SMTP_USE_TLS=True
SMTP_START_TLS=False
SMTP_TIMEOUT=30

# [必填] 发件人地址
# 开发环境：Resend 默认域 onboarding@resend.dev（仅可发送到管理员邮箱）
# 生产环境：改为已验证域名的邮箱，如 GeiIt企业知识库 <noreply@yourdomain.com>
# 验证自有域名：https://resend.com/domains
EMAIL_FROM=GeiIt企业知识库 <onboarding@resend.dev>

# [必填] 管理员通知邮箱（接收注册申请通知）
# 注意：使用 Resend 默认域 onboarding@resend.dev 时，只能发送到 Resend 注册邮箱
ADMIN_NOTIFY_EMAIL=admin@example.com

# [必填] 前端基础 URL（用于拼接邮件中的密码设置链接）
# Railway 生产环境：https://your-frontend.up.railway.app
FRONTEND_BASE_URL=http://localhost:5173

# 密码设置 Token 有效期（小时）
PASSWORD_TOKEN_EXPIRE_HOURS=24

# ============================================
# LLM / Embedding 供应商配置
# ============================================
# 本项目部署选择：阿里云 OpenAI 兼容接口提供主 LLM 与 Embedding；
# DeepSeek OpenAI 兼容接口只提供 LLM 备用。不要将 DeepSeek 配置到 Embedding。
# 具体模型名、阿里云地域/工作空间端点和向量维度由部署者在供应商控制台确认。
# 所有凭据只在部署密钥管理器或本机环境变量中配置，不要提交到仓库。
ALIYUN_API_KEY=
ALIYUN_API_BASE=
ALIYUN_LLM_MODEL=
ALIYUN_EMBEDDING_MODEL=
# 必须与所选模型的输出维度、现有 pgvector 列及迁移状态一致；变更需先规划重建/迁移。
EMBEDDING_DIMENSION=1536
# 仅当所选模型/兼容端点支持 dimensions 参数时设为 true。
EMBEDDING_SUPPORTS_DIMENSIONS=false

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_LLM_MODEL=
DEEPSEEK_LLM_ENABLED=true

# 默认关闭视觉模型；本轮选择只包含 LLM 与 Embedding，需另行配置和验收才可启用。
ALIYUN_VISION_ENABLED=false
ALIYUN_VISION_MODEL=

# 旧版兼容配置。未设置 ALIYUN_*/DEEPSEEK_* 时，仍供旧部署读取。
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-3.5-turbo
LLM_FALLBACK_MODEL_NAME=gpt-3.5-turbo
EMBEDDING_MODEL_NAME=text-embedding-ada-002
VISION_MODEL_NAME=gpt-4o-mini

# 如使用智谱 AI（注释掉上面的，取消注释下面的）
# OPENAI_API_KEY=your-zhipu-api-key
# OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL_NAME=glm-4
# EMBEDDING_MODEL_NAME=embedding-2

# 如使用本地 Ollama
# OPENAI_API_KEY=ollama
# OPENAI_API_BASE=http://localhost:11434/v1
# LLM_MODEL_NAME=qwen2.5:7b
# EMBEDDING_MODEL_NAME=nomic-embed-text

# ============================================
# LLM 容错配置
# ============================================
# [推荐] 以下配置有合理默认值，一般无需修改
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
LLM_TIMEOUT=60
# 推理模型（如 deepseek-v4-pro）首字延迟较长（需内部推理后才开始输出）
# 5s 超时会导致健康探测失败→熔断器打开→所有 LLM 调用被拦截
# 非推理模型（如 qwen-plus）5s 足够，推理模型建议 ≥30s
LLM_STREAM_FIRST_TOKEN_TIMEOUT=30
# Aliyun 端点存在间歇性 SSL EOF 错误，调高阈值避免误熔断（5→10）
CIRCUIT_BREAKER_THRESHOLD=10
CIRCUIT_BREAKER_RECOVERY_TIME=60

# ============================================
# 多API部署方案（推荐）
# ============================================
# 作用：支持文本/向量/多模态模型及其降级模型独立配置不同 API 端点
# 配置文件：app/core/model_provider/providers.yaml
# 优先级：环境变量 > .env > YAML 默认值 > YAML 字面值
# 兼容性：不设置以下变量时，系统完全兼容现有配置（主备共用同一 API）

# 遗留 LLM_FALLBACK_* 仅用于兼容旧配置，不与上方 DEEPSEEK_* 混用。
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_API_BASE=
LLM_FALLBACK_ENABLED=false

# 可选：仅当准备好同向量空间的第二个 Embedding 服务时开启；不得复用 DeepSeek LLM 端点。
EMBEDDING_FALLBACK_ENABLED=false
EMBEDDING_FALLBACK_MODEL_NAME=
EMBEDDING_FALLBACK_API_KEY=
EMBEDDING_FALLBACK_API_BASE=
EMBEDDING_FALLBACK_SUPPORTS_DIMENSIONS=false

# [可选] 本地 LLM 兜底（Ollama，默认关闭）
# Railway 环境无法使用本地 Ollama，保持 false
LOCAL_LLM_ENABLED=false
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_BASE=http://localhost:11434/v1

# [可选] 服务端本地 Embedding provider（默认关闭）
# 仅在安装本地 ML 依赖且模型维度与当前数据库向量列匹配后显式启用。
# 这与桌面客户端的独立本地知识库模型/索引无关，不会自动切换客户端设置。
LOCAL_EMBEDDING_ENABLED=false

# [可选] 降级 Vision API（默认关闭）
# 作用：主多模态模型不可用时，使用降级多模态模型
VISION_FALLBACK_MODEL=
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_API_BASE=
VISION_FALLBACK_ENABLED=false

# ============================================
# 向量检索配置
# ============================================
# [推荐] 以下配置已调优，一般无需修改
SEARCH_TOP_K=6
SIMILARITY_THRESHOLD=0.35
ENABLE_HYBRID_SEARCH=True
KEYWORD_SEARCH_WEIGHT=0.3

# ============================================
# 文档处理配置
# ============================================
# [推荐] 以下配置已调优，一般无需修改
CHUNK_SIZE=800
CHUNK_OVERLAP=100
DOCUMENT_QUALITY_THRESHOLD=60.0
ENABLE_OCR=True
ENABLE_VISION=True
ENABLE_TABLE_EXTRACTION=True

# ============================================
# 记忆衰退配置
# ============================================
# [推荐] 以下配置已调优，一般无需修改
CONVERSATION_HISTORY_LIMIT=5
CONVERSATION_HISTORY_MAX_TOKENS=2000
ENABLE_HISTORY_SUMMARY=True
SUMMARY_EVERY_N_TURNS=5

# ============================================
# 限流配置
# ============================================
# [推荐] 以下配置已调优，一般无需修改
ENABLE_RATE_LIMIT=True
RATE_LIMIT_GLOBAL_PER_MINUTE=100
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_ASK_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_HOUR=20
LOGIN_FAILURE_LOCK_THRESHOLD=5
LOGIN_FAILURE_LOCK_MINUTES=15

# ============================================
# 监控配置（可选）
# ============================================
ENABLE_SENTRY=False
SENTRY_DSN=

# ============================================
# Prometheus 监控配置
# ============================================
# L-12 修复：ENABLE_PROMETHEUS 从上方"监控配置"区移至此处，与其他 PROMETHEUS_ 变量统一管理
ENABLE_PROMETHEUS=False
PROMETHEUS_METRICS_PATH=/metrics
PROMETHEUS_AUTH_ENABLED=False
PROMETHEUS_AUTH_USER=prometheus
PROMETHEUS_AUTH_PASSWORD=
# 是否在 http_requests_total 中包含路径标签
# true：按端点路径维度切分（开发环境便于排查）
# false：返回 unlabeled，避免高基数导致 Prometheus 内存爆炸（生产环境推荐）
PROMETHEUS_INCLUDE_PATH_LABEL=True

# 第四阶段 RAG 优化功能开关
# 意图识别：闲聊/追问/元问题走无检索路径，避免误拦截
ENABLE_INTENT_DETECTION=True
# 矛盾检测：检索结果冲突时标记
ENABLE_CONFLICT_DETECTION=True
# LaTeX 公式保护：分块时不破坏 $...$ 公式
ENABLE_LATEX_PROTECTION=True

REQUEST_LOG_SAMPLE_RATE=1.0

# ============================================
# 性能调优配置
# ============================================
# 模型健康检查启动模式
# False（默认）：非阻塞，健康检查后台异步启动，应用立即就绪（生产推荐）
# True：阻塞，等待健康检查 Task 创建后再就绪（调试用）
MODEL_EAGER_HEALTH_CHECK=False

# ============================================
# 超级管理员初始化（仅部署时使用，非运行时配置）
# ============================================
# 作用：部署后通过 python -m scripts.create_superuser 创建超级管理员
# 使用方式：
#   1. 设置以下三个变量
#   2. 执行：python -m scripts.create_superuser
#   3. 创建完成后删除 SUPERUSER_PASSWORD（避免密码暴露）
#
# 安全要求：
#   - 密码 ≥8 字符，必须包含字母和数字
#   - 创建后立即删除这些变量，不要长期保留在配置中
# SUPERUSER_USERNAME=admin
# SUPERUSER_EMAIL=admin@example.com
# SUPERUSER_PASSWORD=Secure123
